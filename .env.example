VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_TELEGRAM_PROVIDER=custom:three-k-telegram

# Configure these in Supabase Auth custom OIDC provider, not in the browser app.
# TELEGRAM_OIDC_CLIENT_ID=YOUR_TELEGRAM_LOGIN_WIDGET_CLIENT_ID
# TELEGRAM_OIDC_CLIENT_SECRET=YOUR_TELEGRAM_LOGIN_WIDGET_CLIENT_SECRET

# Edge Function runtime variables
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEYS={"default":"SUPABASE_PUBLISHABLE_KEY"}
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
